{
  "name": "my-browser",
  "version": "2.1.0",
  "description": "基于 Electron 开发的浏览器",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "predev": "npm run vite:build",
    "dev": "env-cmd -f .env electron . --enable-logging --lang=zh-CN",
    "vite:build": "vite build",
    "typecheck": "tsc --noEmit",
    "test:mcp": "node --test \"test/mcp/*.test.js\"",
    "test:mcp:e2e": "node --test --test-concurrency=1 \"test/mcp/*.e2e.js\"",
    "prebuild": "npm run vite:build",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "pack": "electron-builder --dir",
    "predist": "npm run vite:build",
    "dist": "electron-builder --publish=never",
    "dist:local": "env-cmd -f .env electron-builder --publish=never",
    "release": "electron-builder --publish=always",
    "postinstall": "electron-builder install-app-deps",
    "icons": "node scripts/create-icons.js scripts/fan.png"
  },
  "keywords": [
    "electron",
    "browser",
    "web-browser"
  ],
  "author": {
    "name": "yunnysunny",
    "email": "yunnysunny@gmail.com"
  },
  "license": "MIT",
  "packageManager": "pnpm@12.16.1",
  "devDependencies": {
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "env-cmd": "^10.1.0",
    "icns-gen": "^1.1.0",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.34.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vite-plugin-static-copy": "^3.1.2"
  },
  "build": {
    "asar": true,
    "appId": "com.whyun.my-browser",
    "productName": "MyBrowser",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/main/**/*",
      "src/dist/**/*",
      "!**/bookmarks.json",
      "node_modules/**/*",
      "!node_modules/.cache",
      "!node_modules/.pnpm"
    ],
    "extraResources": [
      {
        "from": "README.md",
        "to": "README.md"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "src/main/mcp/stdio-bridge.js",
        "to": "mcp/stdio-bridge.js"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "allowElevation": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "verifyUpdateCodeSignature": false,
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Development"
    },
    "publish": []
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "node-slogger": "^3.0.0",
    "zod": "4.6.7"
  }
}
